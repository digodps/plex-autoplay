PLEX_URL=http://host.docker.internal:32400
PLEX_TOKEN=seu_token_aqui
WEB_HOST_PORT=8080
# SETUP_TOKEN=defina-um-token-aqui-para-evitar-geracao-automatica
AUTO_SKIP_INTRO=true
AUTO_NEXT_EPISODE=true
NEXT_EPISODE_THRESHOLD_SECONDS=15
ACTION_DELAY_SECONDS=5
POLL_INTERVAL_SECONDS=2
# PlexAutoSkip integration paths (optional override)
# PLEX_AUTOPLAY_CUSTOM_JSON_PATH=/config/plexautoskip/custom.json
# PLEX_AUTOPLAY_CONFIG_DIR=/config/plexautoskip
ALLOWED_CLIENT_IDS=
ALLOWED_USERNAMES=
DASHBOARD_COOKIE_SECURE=true
DASHBOARD_HTTPS=true
DASHBOARD_TLS_HOSTS=localhost,plex-autoplay,host.docker.internal
LOG_LEVEL=INFO
SCAN_INTERVAL_MINUTES=5
WEBHOOK_SECRET=
REDIS_URL=redis://127.0.0.1:6379/0
# Caminho no host onde ficam os arquivos de mídia (ex.: /mnt/media). Será montado em /Media dentro do container.
# MEDIA_ROOT_HOST=/mnt/media
