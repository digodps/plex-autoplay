PLEX_URL=http://host.docker.internal:32400
PLEX_TOKEN=seu_token_aqui
WEB_HOST_PORT=8080
MEDIA_ROOT_HOST=/path/on/host/media
AUTO_SKIP_INTRO=true
AUTO_NEXT_EPISODE=true
NEXT_EPISODE_THRESHOLD_SECONDS=15
POLL_INTERVAL_SECONDS=2
ALLOWED_CLIENT_IDS=
ALLOWED_USERNAMES=
CUSTOM_MARKERS_FILE=/config/markers.json
DEFAULT_INTRO_SKIP_SECONDS=0
AUTO_GENERATE_ANIME_MARKERS=true
ANIME_MARKERS_CACHE_FILE=/config/metadata-cache.json
ANIME_MARKERS_CACHE_TTL_HOURS=168
DASHBOARD_COOKIE_SECURE=true
DASHBOARD_HTTPS=true
DASHBOARD_TLS_HOSTS=localhost,plex-autoplay,host.docker.internal
LOG_LEVEL=INFO
