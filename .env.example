# =============================================================================
# Plex Autoplay (.NET 10) - Configuração de Ambiente (Modo Dev)
# =============================================================================
# Copie este arquivo para .env e preencha os valores antes de iniciar.
# =============================================================================

# --- Plex Media Server ---
# URL base do seu Plex Media Server (ex: http://192.168.1.50:32400)
PLEX_URL=http://host.docker.internal:32400

# Token de autenticação do Plex (conta Owner/Admin com permissão de escrita)
# Obtenha em: https://plex.tv/claim ou nas configurações de conta do Plex Web App
PLEX_TOKEN=seu_token_plex_aqui

# --- Autenticação (JWT Stateless, sem expiração) ---
# Chave secreta para assinar os tokens JWT. Mude em produção!
JWT_SECRET=sua_chave_secreta_jwt_mude_em_producao

# Senha de acesso único ao painel administrativo
ADMIN_PASSWORD=admin123

# --- Portas ---
# Porta HTTP da API + Vue SPA (interno: 8080)
WEB_PORT=8080

# Porta WebSocket do PlexAutoSkip (interno: 8081)
WS_PORT=8081

# --- Sincronização ---
# Intervalo em minutos entre varreduras automáticas das bibliotecas (padrão: 5)
SYNC_INTERVAL_MINUTES=5

# Caminho do SQLite marker database dentro do container (padrão: /data/SQLite marker database)

# --- Caminho de Mídia (OBRIGATÓRIO) ---
# Caminho absoluto no HOST onde o Plex armazena os arquivos de mídia.
# Será montado como volume em /media dentro do container.
# Exemplo: /mnt/plex/media  ou  /Volumes/Media  ou  /home/usuario/PlexMedia
# MEDIA_ROOT=/caminho/para/sua/midia

# --- Outras configurações (opcionais) ---
APP_CONFIG_PATH=/data/app-config.json

# --- Certificado TLS / HTTPS ---
# Caminho para arquivo PFX no container (montado por volume Docker)
# Exemplo: CERT_PATH=/app/certs/plex-autoplay.pfx
CERT_PATH=
# Senha do arquivo PFX (opcional)
# Exemplo: CERT_PASSWORD=minha_senha_pfx
CERT_PASSWORD=
# Conteúdo base64 de um arquivo PFX (alternativa a CERT_PATH)
# Exemplo: CERT_BASE64=MIIK...conteudo_base64_aqui...
CERT_BASE64=
# Porta HTTPS (padrão: 443)
HTTPS_PORT=443
# Desabilitar listener HTTP completamente (true = apenas HTTPS/WSS, false = permite HTTP interno atrás de proxy de nuvem)
DISABLE_HTTP=true

# --- Ambiente ---
# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Development
# Nível de log (Information, Debug, Warning, Error)
LOG_LEVEL=Information
# Hosts permitidos para requisições
ALLOWED_HOSTS=*

# --- OpenTelemetry (Observabilidade) ---
# Exportador de telemetria: console (dev) ou otlp (produção)
OTEL_EXPORTER=console
# Endpoint OTLP (apenas necessário quando OTEL_EXPORTER=otlp)
# Exemplo: http://localhost:4317
OTEL_ENDPOINT=
# Nome do serviço para identificação nos traces/métricas
OTEL_SERVICE_NAME=plex-autoplay
