# syntax=docker/dockerfile:1
FROM node:20-slim

# Install curl for health checks and Playwright system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Install Playwright browsers pinned to tests/e2e lockfile version.
# Using bare `npx playwright` fetched latest CLI -> browser revision mismatch.
WORKDIR /opt/e2e
COPY tests/e2e/package.json tests/e2e/package-lock.json ./
RUN npm ci && npx playwright install --with-deps chromium && npm cache clean --force

WORKDIR /workspace

# Copy the test runner script to a location outside the volume mount
COPY scripts/run-e2e-tests.sh /usr/local/bin/run-e2e-tests.sh
RUN chmod +x /usr/local/bin/run-e2e-tests.sh

ENTRYPOINT ["bash", "/usr/local/bin/run-e2e-tests.sh"]
